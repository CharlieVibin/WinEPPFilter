;
; WinEPPFilter.inf
; Windows Enhance Pointer Precision to Raw Input Kernel Filter Driver
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = Mouse
ClassGuid   = {4d36e96f-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
CatalogFile = WinEPPFilter.cat
DriverVer   = 08/29/2026,1.0.0.1
PnpLockDown = 1

[DestinationDirs]
DefaultDestDir = 12 ; %windir%\system32\drivers

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
WinEPPFilter.sys = 1,,

[Manufacturer]
%ManufacturerName% = Standard,NTamd64

[Standard.NTamd64]
%WinEPPFilter.DeviceDesc% = WinEPPFilter_Install, HID\VID_DEFAULT&MI_00

[WinEPPFilter_Install.NT]
CopyFiles = Drivers_Dir

[WinEPPFilter_Install.NT.HW]
AddReg = WinEPPFilter_HW_AddReg

[WinEPPFilter_HW_AddReg]
HKR,,"UpperFilters",0x00010000,"WinEPPFilter"

[Drivers_Dir]
WinEPPFilter.sys

[WinEPPFilter_Install.NT.Services]
AddService = WinEPPFilter,,WinEPPFilter_Service_Inst
Include    = msfilter.inf
Needs      = Mouse.Services

[WinEPPFilter_Service_Inst]
DisplayName    = %WinEPPFilter.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\WinEPPFilter.sys
LoadOrderGroup = Pointer Port

[Strings]
ProviderName            = "WinEPP Project"
ManufacturerName        = "LowLatency Input Lab"
DiskName                = "WinEPP Installation Media"
WinEPPFilter.DeviceDesc = "Windows EPP Raw Input Filter Device"
WinEPPFilter.SVCDESC    = "Windows EPP Kernel Filter Service"
